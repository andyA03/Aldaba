{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": false,
    "paths": {
      "@app/*": ["./src/app/*"],
      "@admin/*": ["./src/admin/*"],
      "@landing/*": ["./src/landing/*"],
      "@shared/*": ["./src/shared/*"],
      "@entities/*": ["./src/entities/*"]
    }
  },
  "include": ["src"]
}
